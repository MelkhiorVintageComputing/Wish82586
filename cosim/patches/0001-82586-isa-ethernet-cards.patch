diff -urN qemu-src.orig/hw/net/starlan10.c qemu-src/hw/net/starlan10.c
--- qemu-src.orig/hw/net/starlan10.c	1970-01-01 01:00:00.000000000 +0100
+++ qemu-src/hw/net/starlan10.c	2026-08-01 08:55:40.335778912 +0200
@@ -0,0 +1,233 @@
+/*
+ * AT&T StarLAN 10 ISA Ethernet card.
+ *
+ * Written for the Wish82586 project.  The card is an 82586 with a window of
+ * shared RAM and four bytes of I/O space, which is the smallest host interface
+ * any 82586 board has, and the closest to what the Wish82586 RTL presents:
+ * memory on its Wishbone master, RESET and CA in its control registers.
+ *
+ * NetBSD drives this board with ai(4), which sits directly on the shared
+ * sys/dev/ic/i82586.c core, so what attaches here is the same driver code the
+ * RTL's testbench has been modelled against all along.
+ *
+ * The layout is from NetBSD's sys/dev/isa/if_aireg.h:
+ *
+ *   I/O + 0   any write resets the 82586
+ *   I/O + 1   any write is a channel attention
+ *   I/O + 6   board type in the low nibble, revision in the high
+ *   I/O + 7   attribute bits
+ *
+ * The chip sees a 16 MB address space with the RAM window at the very top,
+ * which is how ai_attach() computes every pointer it hands the chip.
+ *
+ * This work is licensed under the GNU GPL license version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qemu/units.h"
+#include "exec/address-spaces.h"
+#include "hw/isa/isa.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "net/net.h"
+#include "qom/object.h"
+#include "sysemu/sysemu.h"
+#include "i82586.h"
+
+#define TYPE_ISA_STARLAN10 "isa-starlan10"
+OBJECT_DECLARE_SIMPLE_TYPE(ISAStarlan10State, ISA_STARLAN10)
+
+#define AI_IOSIZE       16
+#define AI_RESET        0
+#define AI_ATTN         1
+#define AI_REVISION     6
+#define AI_ATTRIB       7
+
+#define SL10_BOARD      1       /* ai_names[] is indexed by this minus one */
+#define SL_ATTR_WIDTH   0x04    /* set: 16-bit card bus */
+
+struct ISAStarlan10State {
+    ISADevice parent_obj;
+
+    uint32_t iobase;
+    uint32_t isairq;
+    uint32_t iomem;
+    uint32_t memsize;
+    uint32_t revision;
+
+    MemoryRegion io;
+    MemoryRegion ram;
+
+    I82586State i82586;
+};
+
+static uint64_t starlan10_io_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ISAStarlan10State *s = opaque;
+
+    switch (addr) {
+    case AI_REVISION:
+        return ((s->revision & 0x0f) << 4) | SL10_BOARD;
+    case AI_ATTRIB:
+        return SL_ATTR_WIDTH;
+    default:
+        /* Nothing drives the bus here; an ISA read floats to all ones. */
+        return 0xff;
+    }
+}
+
+static void starlan10_io_write(void *opaque, hwaddr addr, uint64_t val,
+                               unsigned size)
+{
+    ISAStarlan10State *s = opaque;
+
+    switch (addr) {
+    case AI_RESET:
+        i82586_reset(&s->i82586);
+        break;
+    case AI_ATTN:
+        i82586_channel_attention(&s->i82586);
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps starlan10_io_ops = {
+    .read = starlan10_io_read,
+    .write = starlan10_io_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+};
+
+static bool starlan10_can_receive(NetClientState *nc)
+{
+    ISAStarlan10State *s = qemu_get_nic_opaque(nc);
+
+    return i82586_can_receive(&s->i82586);
+}
+
+static ssize_t starlan10_receive(NetClientState *nc, const uint8_t *buf,
+                                 size_t size)
+{
+    ISAStarlan10State *s = qemu_get_nic_opaque(nc);
+
+    return i82586_receive(&s->i82586, buf, size);
+}
+
+static NetClientInfo net_starlan10_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .can_receive = starlan10_can_receive,
